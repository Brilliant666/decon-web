  <script>
    (() => {
      const LANGS = ['en', 'ja', 'zh'];
      const HTML_LANG = { en: 'en', ja: 'ja', zh: 'zh-Hans' };
      const BACK = { en: 'Back to the site', ja: 'サイトに戻る', zh: '返回网站' };
      const saved = (() => { try { return JSON.parse(localStorage.getItem('tj.lang')); } catch (_) { return null; } })();
      const guess = (navigator.languages || [navigator.language || 'en']).map((l) => String(l).slice(0, 2).toLowerCase()).find((l) => LANGS.includes(l));
      const root = document.documentElement;
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      function set(l, keep) {
        root.dataset.lang = l;
        root.lang = HTML_LANG[l];
        document.querySelector('[data-back]').textContent = '← ' + BACK[l];
        document.querySelectorAll('.bar__lang button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lang === l)));
        if (keep) try { localStorage.setItem('tj.lang', JSON.stringify(l)); } catch (_) {}
        mark();
      }
      document.querySelectorAll('.bar__lang button').forEach((b) => b.addEventListener('click', () => set(b.dataset.lang, true)));
      document.querySelector('[data-year]').textContent = new Date().getFullYear();
      // highlight the section being read in the contents list
      function mark() {
        const doc = document.querySelector('.doc[data-l="' + root.dataset.lang + '"]');
        const secs = [...doc.querySelectorAll('.sec')];
        let here = secs[0];
        for (const s of secs) if (s.getBoundingClientRect().top < innerHeight * 0.35) here = s;
        if (innerHeight + scrollY >= document.body.scrollHeight - 4) here = secs[secs.length - 1];
        doc.querySelectorAll('.toc a').forEach((a) => a.classList.toggle('is-here', a.hash === '#' + here.dataset.sec));
      }
      // one id per language block, so #privacy is resolved against the visible language
      function go(smooth) {
        const el = location.hash && document.getElementById(location.hash.slice(1) + '-' + root.dataset.lang);
        if (el) el.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto' });
      }
      document.querySelectorAll('.toc a').forEach((a) => a.addEventListener('click', (ev) => {
        ev.preventDefault();
        history.replaceState(null, '', a.hash);
        go(true);
      }));
      addEventListener('hashchange', () => go(true));
      addEventListener('scroll', mark, { passive: true });
      set(LANGS.includes(saved) ? saved : guess || 'en', false);
      go(false);
    })();
  </script>
